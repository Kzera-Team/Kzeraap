{
  "name": "kzera",
  "version": "0.19.50",
  "private": true,
  "type": "module",
  "description": "Kzera internal package for the public PWA shell.",
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:no-html-in-ts && npm run check:dev-readme-versioning && npm run typecheck && npm test && npm run build",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:no-html-in-ts": "node tools/check-no-html-in-ts.mjs",
    "check:index-html-pr-only": "node tools/check-index-html-pr-only.mjs",
    "check:pr-checklist-evidence": "node tools/check-pr-checklist-evidence.mjs",
    "check:protected-process-changes": "node tools/check-protected-process-changes.mjs",
    "check:visual-mockup-evidence": "node tools/check-visual-mockup-evidence.mjs",
    "check:dev-readme-versioning": "node tools/check-dev-readme-versioning.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}